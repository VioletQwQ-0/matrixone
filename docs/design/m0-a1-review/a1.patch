+func TestM0EngineColumnMapping(t *testing.T) {
+	ctx, fs, loc, mp := m0MappingFixture(t)
+	ty := types.T_int32.ToType()
+	for _, tc := range []struct {
+		name string
+		cols []uint16
+	}{
+		{"reordered mixed projection", []uint16{1, 0, 1}},
+		{"all null projection", []uint16{1}},
+		{"physical only", []uint16{0}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			typs := make([]types.Type, len(tc.cols))
+			for i := range typs {
+				typs[i] = ty
+			}
+			cache := containers.NewVectors(len(tc.cols))
+			release, _, err := loadColumns(ctx, tc.cols, typs, fs, loc, cache, mp, fileservice.SkipAllCache)
+			require.NoError(t, err)
+			defer release()
+			for i, seq := range tc.cols {
+				require.Equal(t, 3, cache[i].Length())
+				require.Equal(t, ty, *cache[i].GetType())
+				if seq == 1 {
+					require.True(t, cache[i].IsConstNull())
+				} else {
+					require.Equal(t, []int32{11, 22, 33}, vector.MustFixedColWithTypeCheck[int32](&cache[i]))
+				}
+			}
+		})
+	}
+
+	t.Run("physical reader receives no suffix authority", func(t *testing.T) {
+		cache := containers.NewVectors(1)
+		_, _, err := ioutil.LoadColumns(physicalM0Read(ctx), []uint16{1}, []types.Type{ty}, fs, loc, cache, mp, fileservice.SkipAllCache)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("ordinary no proof still rejects", func(t *testing.T) {
+		cache := containers.NewVectors(1)
+		_, _, err := loadColumns(context.Background(), []uint16{1}, []types.Type{ty}, fs, loc, cache, mp, fileservice.SkipAllCache)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("wrong object", func(t *testing.T) {
+		wrong := objectio.WithM0ProvenObject(ctx, objectio.M0ObjectProof{ObjectName: "other", WrittenSize: 1, SchemaSize: 2})
+		_, err := mapM0Columns(wrong, []uint16{1}, []types.Type{ty}, fs, loc)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("schema bound", func(t *testing.T) {
+		_, err := mapM0Columns(ctx, []uint16{2}, []types.Type{ty}, fs, loc)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("physical type mismatch", func(t *testing.T) {
+		_, err := mapM0Columns(ctx, []uint16{0, 1}, []types.Type{types.T_int64.ToType(), ty}, fs, loc)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("prefix width mismatch", func(t *testing.T) {
+		wrong := objectio.WithM0ProvenObject(ctx, objectio.M0ObjectProof{ObjectName: loc.Name().String(), WrittenSize: 2, SchemaSize: 3})
+		_, err := mapM0Columns(wrong, []uint16{2}, []types.Type{ty}, fs, loc)
+		require.ErrorIs(t, err, objectio.ErrMissingColumnWithoutProof)
+	})
+	t.Run("canceled", func(t *testing.T) {
+		canceled, cancel := context.WithCancel(ctx)
+		cancel()
+		_, err := mapM0Columns(canceled, []uint16{1}, []types.Type{ty}, fs, loc)
+		require.ErrorIs(t, err, context.Canceled)
+	})
+}
