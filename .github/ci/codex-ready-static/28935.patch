 	return found
 }
 
+// A legacy stored generated value was materialized with binary-JSON CRC32.
+// Keep reads and source-side rebuilds available, but do not let new DML mix
+// text-byte values into the same column and its indexes. A newly authored
+// table binds overload 1 and is writable after the normal protocol admission.
+func rejectLegacyCRC32StoredGeneratedWrite(ctx context.Context, table *planpb.TableDef) error {
+	if table == nil {
+		return nil
+	}
+	for _, col := range table.Cols {
+		if col != nil && col.GeneratedCol != nil && col.GeneratedCol.IsStored && containsLegacyCRC32(col.GeneratedCol.Expr) {
+			return moerr.NewNotSupported(ctx, "writing a table with a legacy CRC32 JSON stored generated column requires an explicit table rebuild")
+		}
+	}
+	return nil
+}
